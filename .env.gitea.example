# Gitea Storage Configuration
# Set to true to use Gitea for file storage, false to use default storage
USE_GITEA_STORAGE=true

# Gitea server URL (without trailing slash)
GITEA_URL=http://localhost:3000

# Gitea API token (create from Gitea Settings > Applications > Generate New Token)
# Required permissions: repo (read/write)
GITEA_TOKEN=your_gitea_token_here

# Gitea repository owner (username or organization)
GITEA_OWNER=cheersai

# Gitea repository name for file storage
GITEA_REPO=file-storage
