# CheersAI plugin signature verification environment.
#
# Use this with the plugin-daemon process, not the API or web process.
# For non-Docker servers, copy the public key to the path below and load this
# file from systemd, supervisor, PM2, or the shell that starts plugin-daemon.

THIRD_PARTY_SIGNATURE_VERIFICATION_ENABLED=true
THIRD_PARTY_SIGNATURE_VERIFICATION_PUBLIC_KEYS=/etc/dify/plugin-signatures/cheersai-plugin-signing.public.pem
FORCE_VERIFYING_SIGNATURE=true
ENFORCE_LANGGENIUS_PLUGIN_SIGNATURES=false
