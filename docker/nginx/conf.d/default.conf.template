# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};
    resolver 127.0.0.11 ipv6=off;

    location /console/api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /api/auth/sso {
      proxy_pass http://${NGINX_WEB_UPSTREAM};
      include proxy.conf;
      proxy_set_header Host ${NGINX_WEB_HOST_HEADER};
    }

    location = /api/nexus/beta-applications/apply {
      proxy_pass https://uat-nexus.cheersai.cloud/api/v1/beta-applications/apply;
      proxy_http_version 1.1;
      proxy_set_header Host uat-nexus.cheersai.cloud;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_ssl_server_name on;
      proxy_connect_timeout 60s;
      proxy_send_timeout 300s;
      proxy_read_timeout 300s;
      proxy_buffering off;
    }

    location = /api/nexus/beta-applications/apply/ {
      proxy_pass https://uat-nexus.cheersai.cloud/api/v1/beta-applications/apply;
      proxy_http_version 1.1;
      proxy_set_header Host uat-nexus.cheersai.cloud;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_ssl_server_name on;
      proxy_connect_timeout 60s;
      proxy_send_timeout 300s;
      proxy_read_timeout 300s;
      proxy_buffering off;
    }

    location /api/nexus/ {
      proxy_pass http://${NGINX_WEB_UPSTREAM};
      include proxy.conf;
      proxy_set_header Host $host;
    }

    location /api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /v1 {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /files {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://${NGINX_WEB_UPSTREAM};
      include proxy.conf;
      proxy_set_header Host ${NGINX_WEB_HOST_HEADER};
    }

    location /serwist/ {
      return 404;
    }

    location /e/ {
      set $plugin_daemon_upstream plugin_daemon:5002;
      proxy_pass http://$plugin_daemon_upstream;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location / {
      proxy_pass http://${NGINX_WEB_UPSTREAM};
      include proxy.conf;
      proxy_set_header Host ${NGINX_WEB_HOST_HEADER};
    }

    location /mcp {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass http://api:5001;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
