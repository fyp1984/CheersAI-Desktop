# Local environment template for desktop web
NEXT_PUBLIC_DEPLOY_ENV=DEVELOPMENT
NEXT_PUBLIC_EDITION=SELF_HOSTED
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_PREFIX=http://127.0.0.1:5001/console/api
NEXT_PUBLIC_PUBLIC_API_PREFIX=http://127.0.0.1:5001/api
NEXT_PUBLIC_COOKIE_DOMAIN=

# Nexus API base URL used by beta-application proxy route
NEXUS_API_BASE_URL=http://127.0.0.1:5173
NEXT_PUBLIC_NEXUS_API_PREFIX=

# Desktop SSO configuration
# Must be SSO base URL, e.g. http://127.0.0.1:8000
NEXT_PUBLIC_DESKTOP_SSO_LOGIN_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DESKTOP_SSO_CLIENT_ID=
NEXT_PUBLIC_DESKTOP_SSO_PROTOCOL=oauth
NEXT_PUBLIC_DESKTOP_SSO_ENABLED=true

# Optional: server-side secret for SSO token exchange
DESKTOP_SSO_CLIENT_SECRET=
